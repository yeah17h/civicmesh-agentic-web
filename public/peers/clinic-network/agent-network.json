      "name": "clinic_triage_agent",
      "role": "peer-specialist",
      "function": {
        "description": "Finds open emergency clinics and verifies live cold-chain medication stock (insulin, oxygen, trauma kits, inhalers) across city districts.",
        "parameters": {
          "type": "object",
          "properties": {
            "district": {
              "type": "string",
              "enum": ["Harbor", "Midtown", "Eastside", "Northgate", "Any"]
            },
            "medical_need": {
              "type": "string",
              "enum": ["insulin", "oxygen", "first_aid", "pediatric", "general"]
            }
          },
          "required": ["medical_need"],
          "additionalProperties": false
        }
      },
      "instructions": "Return verified open clinics matching the requested medical need and district, highlighting cold-chain backup power and average wait times.",
      "tools": ["peer_data://clinics"]
    }
  ],
